<div class="min-h-screen bg-gray-50 flex flex-col">
  <!-- Navigation -->
  <nav class="bg-white border-b sticky top-0 z-40 safe-area-inset-top">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-3 flex justify-between items-center">
      <.link navigate={~p"/"} class="text-xl font-bold text-emerald-600 flex items-center gap-2">
        <div class="w-8 h-8 bg-emerald-600 rounded-lg flex items-center justify-center">
          <.icon name="hero-microphone" class="w-4 h-4 text-white" />
        </div>
        <span class="hidden sm:inline">ScriptVivo</span>
      </.link>

      <div class="flex items-center gap-2 sm:gap-4">
        <.link navigate={~p"/browse"} data-path="/browse" class="top-nav-link text-gray-600 hover:text-gray-900 font-medium text-sm sm:text-base px-2 py-1">
          Scripts
        </.link>
        <.link navigate={~p"/collectives"} data-path="/collectives" class="top-nav-link text-gray-600 hover:text-gray-900 font-medium text-sm sm:text-base px-2 py-1">
          Collectives
        </.link>

        <%= if assigns[:current_user] do %>
          <!-- User Menu with Dropdown -->
          <div class="relative" id="user-menu">
            <button
              type="button"
              class="flex items-center gap-2 bg-gray-100 hover:bg-gray-200 px-3 py-1.5 rounded-full transition"
              onclick="document.getElementById('user-dropdown').classList.toggle('hidden')"
            >
              <%= if @current_user.verification_status == "verified" do %>
                <.verified_badge />
              <% end %>
              <span class="text-sm font-medium truncate max-w-[100px] sm:max-w-none">
                <%= @current_user.name %>
              </span>
              <.icon name="hero-chevron-down" class="w-4 h-4 text-gray-500" />
            </button>

            <!-- Dropdown Menu -->
            <div id="user-dropdown" class="hidden absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-lg border py-2 z-50">
              <!-- Settings Links -->
              <div class="py-1 border-b">
                <.link
                  navigate={~p"/profile/#{@current_user.id}"}
                  class="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"
                >
                  <.icon name="hero-user" class="w-4 h-4 text-gray-400" />
                  View Public Profile
                </.link>
                <.link
                  navigate={~p"/settings/pricing"}
                  class="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"
                >
                  <.icon name="hero-currency-dollar" class="w-4 h-4 text-gray-400" />
                  Pricing Settings
                </.link>
                <.link
                  navigate={~p"/settings/payments"}
                  class="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"
                >
                  <.icon name="hero-credit-card" class="w-4 h-4 text-gray-400" />
                  Payment Settings
                </.link>
              </div>

              <!-- Logout -->
              <div class="py-1">
                <.link
                  href={~p"/session"}
                  method="delete"
                  class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50"
                >
                  <.icon name="hero-arrow-right-on-rectangle" class="w-4 h-4" />
                  Sign Out
                </.link>
              </div>
            </div>
          </div>
        <% else %>
          <.link navigate={~p"/login"} class="text-gray-600 hover:text-gray-900 font-medium text-sm sm:text-base px-2 py-1">
            Log In
          </.link>
          <.link navigate={~p"/verify"} class="bg-emerald-600 text-white px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-sm font-medium hover:bg-emerald-700 transition">
            Get Started
          </.link>
        <% end %>
      </div>
    </div>
  </nav>

  <!-- Click outside to close dropdown + Top nav highlighting -->
  <script>
    document.addEventListener('click', function(e) {
      var dropdown = document.getElementById('user-dropdown');
      var menu = document.getElementById('user-menu');
      if (dropdown && menu && !menu.contains(e.target)) {
        dropdown.classList.add('hidden');
      }
    });

    // Highlight active top nav links
    function updateTopNav() {
      const path = window.location.pathname;
      document.querySelectorAll('.top-nav-link').forEach(link => {
        const linkPath = link.dataset.path;
        if (path === linkPath || path.startsWith(linkPath + '/')) {
          link.classList.remove('text-gray-600');
          link.classList.add('text-emerald-600');
        } else {
          link.classList.remove('text-emerald-600');
          link.classList.add('text-gray-600');
        }
      });
    }
    updateTopNav();
    window.addEventListener('phx:page-loading-stop', updateTopNav);
  </script>

  <!-- Main Content -->
  <main class={["flex-1", assigns[:current_user] && "pb-16 sm:pb-0"]}>
    <.flash_group flash={@flash} />
    <%= @inner_content %>
  </main>

  <!-- Bottom Navigation - Mobile only, dashboard tabs for logged in users -->
  <%= if assigns[:current_user] do %>
    <nav id="bottom-nav" class="sm:hidden fixed bottom-0 left-0 right-0 bg-white border-t z-40 safe-area-inset-bottom">
      <div class="flex justify-around items-center py-2 max-w-lg mx-auto">
        <!-- Overview/Home -->
        <.link navigate={~p"/dashboard"} data-tab="overview" class="bottom-nav-link flex flex-col items-center gap-0.5 px-3 py-1 text-gray-500">
          <.icon name="hero-home" class="w-6 h-6" />
          <span class="text-xs">Home</span>
        </.link>

        <!-- Writer: My Scripts / Performer: My Audio -->
        <%= if @current_user.user_type == "writer" do %>
          <.link navigate={~p"/dashboard?tab=screenplays"} data-tab="screenplays" class="bottom-nav-link flex flex-col items-center gap-0.5 px-3 py-1 text-gray-500">
            <.icon name="hero-document-text" class="w-6 h-6" />
            <span class="text-xs">Scripts</span>
          </.link>
        <% else %>
          <.link navigate={~p"/dashboard?tab=audio"} data-tab="audio" class="bottom-nav-link flex flex-col items-center gap-0.5 px-3 py-1 text-gray-500">
            <.icon name="hero-microphone" class="w-6 h-6" />
            <span class="text-xs">Audio</span>
          </.link>
        <% end %>

        <!-- Commissions -->
        <.link navigate={~p"/dashboard?tab=commissions"} data-tab="commissions" class="bottom-nav-link flex flex-col items-center gap-0.5 px-3 py-1 text-gray-500">
          <.icon name="hero-clipboard-document-list" class="w-6 h-6" />
          <span class="text-xs">Jobs</span>
        </.link>

        <!-- Voice Artist: Collectives -->
        <%= if @current_user.user_type == "voice_artist" do %>
          <.link navigate={~p"/dashboard?tab=collectives"} data-tab="collectives" class="bottom-nav-link flex flex-col items-center gap-0.5 px-3 py-1 text-gray-500">
            <.icon name="hero-user-group" class="w-6 h-6" />
            <span class="text-xs">Groups</span>
          </.link>
        <% end %>

        <!-- Profile -->
        <.link navigate={~p"/dashboard?tab=profile"} data-tab="profile" class="bottom-nav-link flex flex-col items-center gap-0.5 px-3 py-1 text-gray-500">
          <.icon name="hero-user" class="w-6 h-6" />
          <span class="text-xs">Profile</span>
        </.link>
      </div>
    </nav>

    <script>
      // Highlight active bottom nav tab
      function updateBottomNav() {
        const path = window.location.pathname;
        const params = new URLSearchParams(window.location.search);
        const tab = params.get('tab') || 'overview';

        document.querySelectorAll('.bottom-nav-link').forEach(link => {
          const linkTab = link.dataset.tab;
          if (path === '/dashboard' && linkTab === tab) {
            link.classList.remove('text-gray-500');
            link.classList.add('text-emerald-600');
          } else {
            link.classList.remove('text-emerald-600');
            link.classList.add('text-gray-500');
          }
        });
      }
      updateBottomNav();
      window.addEventListener('phx:page-loading-stop', updateBottomNav);
    </script>
  <% end %>
</div>
